diff --git a/tests/test_obe_escalation_card.py b/tests/test_obe_escalation_card.py
index 35a2f14..df2d021 100644
--- a/tests/test_obe_escalation_card.py
+++ b/tests/test_obe_escalation_card.py
@@ -5,6 +5,58 @@ from datetime import datetime
 from scripts import obe_escalation_card as escalation
 
 
+def test_create_card_uses_bare_ticket(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        escalation.subprocess, "run",
+        lambda argv, **kwargs: calls.append((argv, kwargs)) or type(
+            "Result", (), {"stdout": '{"created": true}', "stderr": ""}
+        )(),
+    )
+
+    escalation.create_card("health", "Needs owner decision", "20260805", False)
+
+    assert "--bare" in calls[0][0]
+
+
+def test_create_card_blocks_poisoned_non_bare_transport(monkeypatch):
+    calls = []
+
+    def guarded_run(argv, **kwargs):
+        assert "--bare" in argv, "non-bare transport would add the Open Engine template"
+        calls.append((argv, kwargs))
+        return type("Result", (), {"stdout": '{"created": true}', "stderr": ""})()
+
+    monkeypatch.setattr(escalation.subprocess, "run", guarded_run)
+
+    result = escalation.create_card(
+        "health", "Needs owner decision\n\nFull escalation detail", "20260805", False,
+    )
+
+    assert result["created"] is True
+    assert len(calls) == 1
+
+
+def test_create_card_passes_minimal_decision_body(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        escalation.subprocess, "run",
+        lambda argv, **kwargs: calls.append((argv, kwargs)) or type(
+            "Result", (), {"stdout": '{"created": true}', "stderr": ""}
+        )(),
+    )
+
+    escalation.create_card(
+        "health", "Needs owner decision\n\nFull escalation detail", "20260805", False,
+    )
+
+    argv = calls[0][0]
+    body = argv[argv.index("--body") + 1]
+    assert body.startswith("YOUR MOVE:")
+    assert "WHAT THIS MEANS:" in body
+    assert "Detail\nNeeds owner decision\n\nFull escalation detail" in body
+
+
 def _run(monkeypatch, tmp_path, *, buzzed=True, ledger=None, card=None):
     escalate_file = tmp_path / "ESCALATE.md"
     escalate_file.write_text("Needs owner decision\nFull escalation detail", encoding="utf-8")

 def test_blocked_notice_dedupes_per_draft(tmp_path):
     calls = []
     state = tmp_path / "blocked.json"
     ok = notify.notify_blocked_once("r-1", "g@example.com", "Subj", "voice_qa=fail",
+                                    card="ANK-42",
                                     send=lambda args: calls.append(args) or True,
                                     state_path=state)
     again = notify.notify_blocked_once("r-1", "g@example.com", "Subj", "voice_qa=fail",
+                                       card="ANK-42",
                                        send=lambda args: calls.append(args) or True,
                                        state_path=state)
     assert ok and again
     assert len(calls) == 1  # second block of the same draft stays quiet
 
 
+def test_blocked_notice_without_card_uses_plain_text(tmp_path):
+    calls = []
+    ok = notify.notify_blocked_once(
+        "r-plain", "g@example.com", "Subj", "reason",
+        send=lambda args: calls.append(args) or True,
+        state_path=tmp_path / "blocked.json",
+    )
+    assert ok
+    assert calls[0][0] == "notify-blocked"
+
+
+def test_blocked_card_failure_falls_back_without_raising(monkeypatch, tmp_path):
+    calls = []
+    monkeypatch.setattr(notify, "FAILURE_LOG", tmp_path / "fail.jsonl")
+
+    def send(args):
+        calls.append(args)
+        if args[0] == "prompt":
+            raise RuntimeError("card lane down")
+        return True
+
+    ok = notify.notify_blocked_once(
+        "r-fallback", "g@example.com", "Subj", "reason", card="ANK-42",
+        send=send, state_path=tmp_path / "blocked.json",
+    )
+    assert ok
+    assert calls[0][:3] == ["prompt", "--kind", "escalation"]
+    assert calls[1][0] == "notify-blocked"
+

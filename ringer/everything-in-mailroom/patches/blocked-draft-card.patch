+def test_blocked_notice_with_card_uses_proposal_escalation_lane(tmp_path):
+    calls = []
+    ok = notify.notify_blocked_once(
+        "r-card", "g@example.com", "Subj", "voice_qa=fail", card="ANK-42",
+        send=lambda args: calls.append(args) or True,
+        state_path=tmp_path / "blocked.json",
+    )
+    assert ok
+    assert calls[0][:3] == ["prompt", "--kind", "escalation"]
+    assert "ANK-42" in calls[0]
+    assert "external_send" not in calls[0]
+

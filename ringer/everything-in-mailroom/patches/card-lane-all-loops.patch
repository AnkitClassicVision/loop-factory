+"""Source-contract tests for the podcast loop escalation card lane."""
+import re
+from pathlib import Path
+
+import pytest
+
+
+SCRIPT = (
+    Path(__file__).resolve().parents[1] / "scripts" / "run_podcast_loop.sh"
+).read_text()
+CARD_LOOPS = {
+    "health",
+    "referral-flywheel",
+    "guest-acquisition",
+    "booking-readiness",
+    "production-publish",
+    "sales-handoff",
+    "proof-improvement",
+}
+
+
+def deliver_escalation_once_body(script=SCRIPT):
+    return re.search(
+        r"deliver_escalation_once\(\) \{(?P<body>.*?)\n\}", script, re.DOTALL
+    ).group("body")
+
+
+def assert_all_loops_use_card_lane(script):
+    body = deliver_escalation_once_body(script)
+    pattern = re.search(r'case "\$LOOP" in\s+(?P<pattern>[^)]+)\)', body).group(
+        "pattern"
+    )
+    assert set(pattern.split("|")) == CARD_LOOPS
+
+
+def test_all_loops_use_card_lane():
+    assert_all_loops_use_card_lane(SCRIPT)
+
+
+def test_card_lane_guard_rejects_missing_loop():
+    poisoned_script = SCRIPT.replace(
+        '  case "$LOOP" in\n'
+        "    health|referral-flywheel|guest-acquisition|booking-readiness|"
+        "production-publish|sales-handoff|proof-improvement)",
+        '  case "$LOOP" in\n'
+        "    health|referral-flywheel|guest-acquisition|booking-readiness|"
+        "production-publish|sales-handoff)",
+        1,
+    )
+    with pytest.raises(AssertionError):
+        assert_all_loops_use_card_lane(poisoned_script)
+
+
+def test_card_lane_invocation_is_present():
+    body = deliver_escalation_once_body()
+    assert '"$REPO/scripts/obe_escalation_card.py"' in body
+
+
+def test_plain_telegram_fallback_is_present():
+    body = deliver_escalation_once_body()
+    assert "falling back to plain telegram" in body

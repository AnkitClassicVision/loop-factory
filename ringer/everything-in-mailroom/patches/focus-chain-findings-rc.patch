+def guest_acquisition_preflight(script=SCRIPT):
+    return script.split("# Guest-acquisition preflight:", 1)[1].split(
+        "\nTG_FAILED=0", 1
+    )[0]
+
+
+def assert_findings_tolerant_preflight(script):
+    preflight = guest_acquisition_preflight(script)
+    assert (
+        'if [ -s "$FUNNEL_SNAPSHOT" ] && { [ "$FOCUS_RC" -eq 0 ] || '
+        '[ "$FOCUS_RC" -eq 2 ]; }; then'
+    ) in preflight
+    assert 'FOCUS_STATUS_FINDINGS=1' in preflight
+    assert 'FOCUS_RC=0\n    "$PYTHON_BIN" "$REPO/scripts/funnel_evidence.py" focus' in preflight
+    assert 'elif [ "$FOCUS_RC" -eq 0 ]; then\n    FOCUS_RC=1' in preflight
+
+
 def test_all_loops_use_card_lane():
     assert_all_loops_use_card_lane(SCRIPT)
 
 
+def test_guest_acquisition_preflight_accepts_findings_snapshot():
+    assert_findings_tolerant_preflight(SCRIPT)
+
+
+def test_guest_acquisition_preflight_guard_rejects_strict_rc_zero_gate():
+    poisoned_script = SCRIPT.replace(
+        'if [ -s "$FUNNEL_SNAPSHOT" ] && { [ "$FOCUS_RC" -eq 0 ] || '
+        '[ "$FOCUS_RC" -eq 2 ]; }; then',
+        'if [ "$FOCUS_RC" -eq 0 ]; then',
+        1,
+    )
+    with pytest.raises(AssertionError):
+        assert_findings_tolerant_preflight(poisoned_script)
+
+

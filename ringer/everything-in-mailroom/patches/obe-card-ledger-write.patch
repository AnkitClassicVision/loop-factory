@@ -0,0 +1,87 @@
+import json
+import sys
+from datetime import datetime
+
+from scripts import obe_escalation_card as escalation
+
+
+def _run(monkeypatch, tmp_path, *, buzzed=True, ledger=None, card=None):
+    escalate_file = tmp_path / "ESCALATE.md"
+    escalate_file.write_text("Needs owner decision\nFull escalation detail", encoding="utf-8")
+    ledger = ledger or tmp_path / "card_ledger.jsonl"
+    monkeypatch.setenv("OBE_CARD_LEDGER", str(ledger))
+    card = card or {
+        "created": True,
+        "identifier": "ANK-412",
+        "title": "[loop-escalation] health — 20260805",
+        "url": "https://linear.app/example/ANK-412",
+    }
+    monkeypatch.setattr(escalation, "create_card", lambda *_args: card)
+    buzzes = []
+    monkeypatch.setattr(
+        escalation.obe_tg_notify, "notify_escalation",
+        lambda *args: buzzes.append(args) or buzzed,
+    )
+    monkeypatch.setattr(
+        sys, "argv",
+        ["obe_escalation_card.py", "--loop", "health",
+         "--escalate-file", str(escalate_file)],
+    )
+    return escalation.main(), ledger, buzzes
+
+
+def test_successful_card_appends_rearmable_ledger_row(monkeypatch, tmp_path):
+    rc, ledger, _buzzes = _run(monkeypatch, tmp_path)
+
+    assert rc == 0
+    rows = [json.loads(line) for line in ledger.read_text(encoding="utf-8").splitlines()]
+    assert len(rows) == 1
+    row = rows[0]
+    assert row["row_hash"]
+    assert row["card_identifier"] == "ANK-412"
+    assert row["department"] == "podcast"
+    assert row["kind"] == "escalation"
+    assert row["status"] == "open"
+    assert datetime.fromisoformat(row["first_raised"])
+
+
+def test_buzz_failure_still_leaves_ledger_row(monkeypatch, tmp_path):
+    rc, ledger, buzzes = _run(monkeypatch, tmp_path, buzzed=False)
+
+    assert rc == 1
+    assert buzzes
+    assert json.loads(ledger.read_text(encoding="utf-8"))["card_identifier"] == "ANK-412"
+
+
+def test_ledger_failure_still_buzzes_and_exits_nonzero(monkeypatch, tmp_path):
+    failures = []
+    monkeypatch.setattr(
+        escalation.obe_tg_notify, "_log_failure",
+        lambda *args, **kwargs: failures.append((args, kwargs)),
+    )
+    bad_ledger = tmp_path / "missing" / "card_ledger.jsonl"
+
+    rc, _ledger, buzzes = _run(monkeypatch, tmp_path, ledger=bad_ledger)
+
+    assert rc == 1
+    assert buzzes
+    assert failures and failures[0][0][0] == "card_ledger"
+
+
+def test_ledger_row_is_valid_json_on_one_line(monkeypatch, tmp_path):
+    _rc, ledger, _buzzes = _run(monkeypatch, tmp_path)
+
+    raw = ledger.read_text(encoding="utf-8")
+    assert raw.endswith("\n")
+    assert raw.count("\n") == 1
+    assert isinstance(json.loads(raw), dict)
+
+
+def test_card_response_without_identifier_blocks_ledger_and_buzz(monkeypatch, tmp_path):
+    poisoned_card = {"created": True, "title": "missing identifier"}
+
+    rc, ledger, buzzes = _run(monkeypatch, tmp_path, card=poisoned_card)
+
+    assert rc == 1
+    assert not ledger.exists()
+    assert buzzes == []

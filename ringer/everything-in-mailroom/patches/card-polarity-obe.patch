+def test_approve_mapped_to_pause_blocks_card_ledger_and_buzz(monkeypatch, tmp_path, capsys):
+    escalate_file = tmp_path / "ESCALATE.md"
+    escalate_file.write_text("Approve = pause the 10am publish", encoding="utf-8")
+    ledger = tmp_path / "card_ledger.jsonl"
+    monkeypatch.setenv("OBE_CARD_LEDGER", str(ledger))
+    ticket_calls = []
+    monkeypatch.setattr(
+        escalation.subprocess, "run", lambda *args, **kwargs: ticket_calls.append((args, kwargs)),
+    )
+    buzzes = []
+    monkeypatch.setattr(
+        escalation.obe_tg_notify, "notify_escalation",
+        lambda *args: buzzes.append(args),
+    )
+    monkeypatch.setattr(
+        sys, "argv",
+        ["obe_escalation_card.py", "--loop", "health",
+         "--escalate-file", str(escalate_file)],
+    )
+
+    rc = escalation.main()
+
+    result = json.loads(capsys.readouterr().out)
+    assert rc == 1
+    assert "polarity" in result["error"]
+    assert ticket_calls == []
+    assert not ledger.exists()
+    assert buzzes == []
+
+
+def test_default_approve_wording_passes_polarity_lint(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        escalation.subprocess, "run",
+        lambda argv, **kwargs: calls.append((argv, kwargs)) or type(
+            "Result", (), {"stdout": '{"created": true}', "stderr": ""}
+        )(),
+    )
+
+    result = escalation.create_card(
+        "health", "Needs owner decision", "20260805", False,
+    )
+
+    assert result["created"] is True
+    assert len(calls) == 1
+    body = calls[0][0][calls[0][0].index("--body") + 1]
+    assert "YOUR MOVE: Approve = approve the health loop escalation" in body
+
+

+            continue
+        marker = row.get("marker") or row.get("status")
+        if marker == "resolved" or row.get("resolved") is True:
+            active.discard(fingerprint)
+        elif marker == "delivered" or row.get("delivered") is True:
+            active.add(fingerprint)
+    return active
+

+    try:
+        bundle = {
+            "run": [
+                dict(row)
+                for row in connection.execute(
+                    "SELECT * FROM run WHERE run_id = ? OR graph_run_id = ? "
+                    "ORDER BY id",
+                    (graph_run_id, graph_run_id),
+                )
+            ],
+        }

+        (dept / "state" / "envcap.json").read_text(encoding="utf-8"))
+    expected = (dept / "state" / "graph_runs" / result["run_id"] / "spool"
+                / "N1-1")
+    assert captured["spool"] == str(expected)
+    assert captured["kernel_key_leaked"] is False
+

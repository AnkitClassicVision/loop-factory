+def _rollup_state(tmp_path):
+    state = tmp_path / "departments" / "demo" / "state"
+    state.mkdir(parents=True)
+    (state / "STATE.json").write_text(
+        json.dumps({"epoch": 0, "status": "ok", "ok": True}), encoding="utf-8")
+    return state

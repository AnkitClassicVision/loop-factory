+def test_external_action_in_shadow_kills_run(tmp_path):
+    dept = _make_dept(tmp_path, {"sense.py": VIOLATOR, "record.py": RECORD_OK},
+                      _two_node_manifest())
+    result = _run(dept, tmp_path)

+    (dept / "state").mkdir(exist_ok=True)
+    (dept / "state" / "KILL").write_text("stop\n", encoding="utf-8")
+    result = _run(dept, tmp_path)
+    assert result["state"] == "killed"
+    assert _markers(dept) == []

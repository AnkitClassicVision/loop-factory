# Estate board refresh service. Installed DISABLED by convention; the owner
# enables its timer deliberately after review. Shadow-safe: read-only sensing
# plus local feed and HTML writes only.
[Unit]
Description=Refresh the Loop Factory estate board

[Service]
Type=oneshot
WorkingDirectory={{REPO}}
ExecStart=/usr/bin/python3 -m factory.timersense --out estate/state/timers.json --tolerate-missing
# Boardfeed consumes the published canonical projection and refuses direct-read
# fallback. The leading '-' lets an incomplete rebuild continue to boardfeed,
# which sees the .incomplete marker and renders the required warning banner.
ExecStart=-/usr/bin/python3 loopfactory.py rollup --root .
ExecStart=/usr/bin/python3 -m factory.external_departments --repo-root .
ExecStart=/usr/bin/python3 -m factory.boardfeed --repo-root .
ExecStart=/usr/bin/python3 -m factory.board --feed estate/state/board-feed.ndjson --site estate/state/boards

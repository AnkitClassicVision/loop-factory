# DEPRECATED 2026-08-09. Canonical source-controlled timer:
# departments/podcast/systemd/podcast-loop.timer.
[Unit]
Description=DEPRECATED legacy Podcast timer (inert)
ConditionPathExists=/run/loop-factory/legacy-podcast-trigger-never-enable

[Timer]
OnCalendar=*-*-* 00:00:00
Persistent=false

# No install stanza: this unit cannot be enabled from the source artifact.

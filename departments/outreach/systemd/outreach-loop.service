# outreach department loop — oneshot, SHADOW-safe, hardened.
# Install: copy to ~/.config/systemd/user/outreach-loop.service, review,
# then enable the TIMER deliberately (never auto-enabled by the factory).
[Unit]
Description=outreach department loop (loop-factory)

[Service]
Type=oneshot
WorkingDirectory=/mnt/d_drive/repos/loop-factory
ExecStart=/usr/bin/env bash /mnt/d_drive/repos/loop-factory/departments/outreach/runtime/outreach_daily.sh
TimeoutStartSec=600
# Confinement (deny-by-default; departments hold no credentials):
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/d_drive/repos/loop-factory/departments/outreach/state /mnt/d_drive/repos/loop-factory/state
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET
# NO credential-bearing Environment= lines. The lock service reads secrets; the
# department process never does.
Environment=PLACEHOLDER_MODE=1

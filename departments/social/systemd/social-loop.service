[Unit]
Description=Social Loop Factory run (shadow, trusted wrapper)

[Service]
Type=oneshot
WorkingDirectory=/mnt/d_drive/repos/loop-factory
ExecStart=/usr/bin/python3 -m factory.run_driver --department social --root /mnt/d_drive/repos/loop-factory --trigger daily
TimeoutStartSec=900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/d_drive/repos/loop-factory/departments/social/state /mnt/d_drive/repos/loop-factory/state
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET
Environment=PLACEHOLDER_MODE=1
